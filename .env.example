# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string. Leave empty to use the embedded Postgres (PGlite) in .data/
DATABASE_URL=

# Long random string. Keys the hashes of one-time codes and guest codes. Required in production.
APP_SECRET=

# Anthropic API key for complaint triage. Without it, complaints are classified by keyword rules.
ANTHROPIC_API_KEY=

# Claude model used for complaint triage
ANTHROPIC_MODEL=claude-haiku-5-5

# Shared secret that signs the mock payment gateway's callbacks
GATEWAY_SECRET=

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Demo helpers: OTP shown on screen, one-tap demo logins, sample bank statement. Off by default in production;
# the demo deployment turns them on.
DEMO_MODE=true
